PROJECT_NAME="School Security Analytics System v2"
DATABASE_URL=sqlite:///./school_security.db
# Для Docker / Production с PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/school_security
REDIS_URL=redis://redis:6379/0

# ── Аутентификация v2 (JWT + HttpOnly cookie) ────────────────────────────────
# Если не задан — генерируется автоматически в .jwt_secret при первом старте.
# В production ОБЯЗАТЕЛЬНО задайте собственный длинный секрет.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720
AUTH_COOKIE_NAME=school_session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Демо-аккаунты с быстрым входом на странице логина (is_demo=True)
DEMO_LOGIN_ENABLED=true
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_PASSWORD=admin123
DEMO_DIRECTOR_USERNAME=director
DEMO_DIRECTOR_PASSWORD=director123
DEMO_GUARD_USERNAME=guard
DEMO_GUARD_PASSWORD=guard123

# Защита от перебора пароля: попыток за окно (сек)
LOGIN_RATE_LIMIT_ATTEMPTS=12
LOGIN_RATE_LIMIT_WINDOW_SEC=300

# Опциональный секретный ключ доступа к API (заголовок X-API-Key):
API_KEY=
ALLOW_PRIVATE_RTSP=true
ALLOW_LOCAL_WEBCAM=false
MAX_UPLOAD_IMAGE_MB=15
MAX_UPLOAD_VIDEO_MB=60
MAX_STORED_VIOLATIONS=250

# ── Модели YOLOv8 ────────────────────────────────────────────────────────────
YOLO_COCO_MODEL_PATH=ml/models/yolov8n.pt
YOLO_WEAPON_MODEL_PATH=ml/models/weapon_yolov8.pt
YOLO_CUSTOM_MODEL_PATH=ml/models/school_security_best.pt

# Реестр версий весов + Validation Gate
MODEL_VERSIONS_ROOT=ml/versions
MAP50_ROLLBACK_TOLERANCE=0.01
MAP50_MIN_ABSOLUTE=0.35

CONFIDENCE_THRESHOLD=0.42
WEAPON_CONFIDENCE_THRESHOLD=0.50
CUSTOM_CONFIDENCE_THRESHOLD=0.52
UNATTENDED_DISTANCE_RATIO=0.22

# ── Трекинг (ByteTrack-подобный) и таймер выдержки бесхозной сумки ───────────
TRACKER_ENABLED=true
TRACK_IOU_THRESHOLD=0.25
TRACK_MAX_AGE_SEC=3.0
TRACK_MIN_HITS=2
UNATTENDED_DWELL_SEC=6.0
BAG_RELEASE_GRACE_SEC=1.5
VIOLATION_COOLDOWN_SEC=12

# Производительность потокового конвейера
STREAM_TARGET_FPS=12
DETECT_EVERY_N_FRAMES=3

MEDIA_ROOT=media
VITE_API_URL=/api
