PROJECT_NAME="School Security Analytics System"
DATABASE_URL=sqlite:///./school_security.db
REDIS_URL=redis://localhost:6379/0
# Run python scripts/setup_env.py to generate actual secrets in .env.
API_KEY=
# setup_env.py generates a unique first-run password. Never commit real credentials.
# Empty password disables bootstrap; existing users are never overwritten.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
DEV_MODE=false
SEED_DEMO_CAMERAS=false
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]
ALLOW_PRIVATE_RTSP=true
ALLOW_LOCAL_WEBCAM=false
# Static IPs allowed as camera sources, e.g. ["192.168.1.20","192.168.1.21"]
CAMERA_ALLOWED_HOSTS=[]
ALLOW_HTTP_CAMERAS=false
UPLOAD_RETENTION_HOURS=24
MAX_CAMERAS=16
MAX_UPLOAD_IMAGE_MB=15
MAX_UPLOAD_VIDEO_MB=60
MAX_VIDEO_DURATION_SEC=120
MAX_STORED_VIOLATIONS=250
ENABLE_LOCAL_TRAINING=true
TRAINING_TIMEOUT_SEC=7200
YOLO_COCO_MODEL_PATH=ml/models/yolov8n.pt
YOLO_WEAPON_MODEL_PATH=ml/models/weapon_yolov8.pt
# Bundled school_security_best.pt is demo-only; not used by default.
YOLO_CUSTOM_MODEL_PATH=ml/models/active.pt
CONFIDENCE_THRESHOLD=0.42
WEAPON_CONFIDENCE_THRESHOLD=0.50
CUSTOM_CONFIDENCE_THRESHOLD=0.52
UNATTENDED_DISTANCE_RATIO=0.22
UNATTENDED_MIN_SECONDS=30
DETECTION_CONFIRMATIONS=2
VIOLATION_COOLDOWN_SEC=12
MEDIA_ROOT=media
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional JSON webhook for notification systems.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_COOLDOWN_SEC=60
NOTIFICATION_TIMEOUT_SEC=5
